# Copy to .env.production (gitignored) and replace every value. Never commit the filled-in file.
# Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32

# Public HTTPS origins served by your TLS reverse proxy.
WEB_ORIGIN=https://play.example.com
API_ORIGIN=https://api.example.com

# Proxy addresses that append to X-Forwarded-For (comma-separated IPs/CIDRs). Leave empty if the proxy
# overwrites the header with the client address instead.
TRUSTED_PROXIES=

# Transactional email for password resets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lagos Living <no-reply@example.com>

# Optional
RELEASE=local
SERVER_PORT=2567
WEB_PORT=8080
DATABASE_SSL=disable
