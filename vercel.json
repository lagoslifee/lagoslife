{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && VITE_API_URL=https://tests-emissions-suggests-commonwealth.trycloudflare.com VITE_GUEST_MODE=true npm run build -w @lagos-living/web",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
      ]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
