{
  "name": "@lagos-living/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'e2e/**' --exclude 'e2e-prod/**'",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "@colyseus/sdk": "^0.18.5",
    "@lagos-living/shared": "file:../../packages/shared",
    "better-auth": "^1.7.7",
    "earcut": "^3.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  }
}
