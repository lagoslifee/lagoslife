{
  "name": "@lagos-living/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lagos-living/shared": "*",
    "better-auth": "^1.7.7",
    "colyseus": "^0.18.9",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.0"
  }
}
