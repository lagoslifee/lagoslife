{
  "name": "@lagos-living/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "db:migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --dir src",
    "staff:role": "tsx src/staff.ts",
    "load-test": "tsx src/load-test.ts",
    "cluster-check": "tsx src/cluster-check.ts",
    "db:migrate:dist": "node dist/migrate.js"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/redis-driver": "^0.18.5",
    "@colyseus/redis-presence": "^0.18.5",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/ws-transport": "^0.18.4",
    "@lagos-living/shared": "*",
    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.28.2",
    "msgpackr": "^2.1.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.0"
  }
}
