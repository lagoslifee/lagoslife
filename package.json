{
  "name": "lagos-living",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "npm run build --prefix apps/server && npm run build --prefix apps/web",
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev --prefix apps/server\" \"npm run dev --prefix apps/web\"",
    "db:migrate": "npm run db:migrate --prefix apps/server",
    "test": "npm test --prefix packages/shared && npm test --prefix apps/server && npm test --prefix apps/web",
    "typecheck": "npm run typecheck --prefix packages/shared && npm run typecheck --prefix apps/server && npm run typecheck --prefix apps/web"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "@colyseus/core": "^0.18.18",
    "@colyseus/redis-driver": "^0.18.5",
    "@colyseus/redis-presence": "^0.18.5",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@lagos-living/shared": "file:packages/shared",
    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "earcut": "^3.2.4",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "msgpackr": "^2.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
